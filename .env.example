APP_NAME="Release Governance"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sbmtag
DB_USERNAME=sbmtag_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

AUTH_PROVIDER=email_otp
AUTH_OTP_CHANNEL=mail
AUTH_OTP_PEPPER=
AUTH_OTP_DIGITS=6
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_REQUEST_LIMIT=3
AUTH_OTP_IP_REQUEST_LIMIT=30
AUTH_OTP_REQUEST_WINDOW_MINUTES=15
AUTH_OTP_RESEND_SECONDS=60
AUTH_CHALLENGE_RETENTION_HOURS=24
AUTH_INVITATION_TTL_DAYS=7
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=30
AUTH_SESSION_INACTIVITY_MINUTES=15
AUTH_SESSION_ABSOLUTE_MINUTES=480
AUTH_PRIVILEGED_REAUTH_MINUTES=10
AUTH_TOTP_ISSUER="${APP_NAME}"
AUTH_TOTP_WINDOW=1
AUTH_TOTP_RECOVERY_CODE_COUNT=10
AUTH_TOTP_RECOVERY_CODE_LENGTH=12
AUTH_UNCONFIRMED_MFA_TTL_MINUTES=30
AUTH_PENDING_AUTH_TTL_MINUTES=10
AUTH_ADDITIONAL_PRIVILEGED_PERMISSIONS=
AUTH_SECURITY_QUEUE=security
AUTH_EVENT_RETENTION_DAYS=2555

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_ORIGIN=http://localhost:5173
